model {
    database = database ""

}

deployment {
    environment prod {
        zone eu {
            zone zone1 {
                instanceOf genechain.frontend
                instanceOf creditplatform.db
            }
            zone zone2 {
                instanceOf genechain.frontend
                instanceOf creditplatform.db
            }
            instanceOf database
        }
    }
}
views {
    deployment view index-v2 {
        title "部署图"
        link https://likec4.dev

        include prod.**
        // ...
    }
}