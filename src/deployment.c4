model {
    database = repository ""

}
deployment {
    environment prod {
        zone eu {
            zone zone1 {
                instanceOf frontend.gene-chain
                instanceOf backend.api
            }
            zone zone2 {
                instanceOf frontend.gene-chain
                instanceOf backend.api
            }
            instanceOf database
        }
    }
}
views {
    deployment view index-v2 {
        title "Production Deployment"
        link https://likec4.dev

        include prod.**
        // ...
    }
}