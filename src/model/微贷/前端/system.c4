model {
    frontend = system "前端" {
        summary ""
        description "包含C端、B端、小程序、H5"
    }
    backend = system "后端" {
        api = component
    }
    frontend.gene-chain -> backend.api

    trade-system = system "交易系统" {
        portal = app "门户" {
            summary "交易门户"
            description """
      ### Web Application

      > Provides services to customers through
      > the web interface.

      | checks     |     |
      | :--------- | :-- |
      | check 1    | ✅  |
      | check 2    | ⛔️  |
      | check 3    | ✅  |
    """
            technology "Spring"
            technology "REST"
            icon tech:spring
            link http://www.google.com "谷歌"
            link http://www.baidu.com "百度"
            metadata {
                appkey "com.example.portal"
                tags ["frontend", "react", "typescript"]
                environments ["dev", "staging", "prod"]
                version "2.1.0"
                critical true
                framework "React"
                version "18.2.0"
                features ["shopping-cart", "user-auth", "payment", "search"]
                deployment_targets ["staging", "production"]
                team_lead "Alice Johnson"
                developers ["Bob Smith", "Carol Davis", "David Wilson"]
                release_cycle "weekly"
                supported_browsers ["Chrome", "Firefox", "Safari", "Edge"]
                accessibility_level "WCAG 2.1 AA"
                has_mobile_app true
            }
        }
        credit-platform = app "交易平台"
        repository = repository "交易数据库"
        this <-> user


    }
}