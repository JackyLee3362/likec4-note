specification {
    // L1 system
    element actor
    element system 
    

    // L2 container
    element frontend {
        notation '前端'
        style {
            color secondary
        }
    }
    element backend {
        notation '后端'
        style {
            color secondary
        }
    }
    element message {
        notation '消息队列、事件流、消息代理'
        style {
            shape queue
            color secondary
        }
    }
    element storage {
        notation '对象/文件存储'
        style {
            shape bucket
            color secondary
        }
    }
    element cache {
        notation '缓存'
        style {
            shape cylinder
            color secondary
        }
    }
    element database {
        notation '数据库'
        style {
            shape cylinder
            color secondary
        }
    }
    // L3 component
    element component {
        notation '组件'
        style {
            shape component
            color indigo
        }
    }

    // L4
    // ...
}