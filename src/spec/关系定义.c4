specification {
    relationship async {
        title '异步'
        description 'Communication over a message broker'
        technology 'Kafka'
        notation 'Async'
        link https://example.com/async
        multiple true
        line dotted
        color amber
    }
    relationship publish {
        notation '发布'
    }
    relationship subscribes {
        notation '订阅'
    }
    relationship read-write {
        notation '读写'
    }
    relationship trigger {
        notation '触发'
    }
    relationship is-downstream-of
}