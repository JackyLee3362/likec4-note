views {
    dynamic view bizflow-cashloan-credit-biz {
        title "生活费授信流程"
        variant sequence
        user
            -> genechain "授信申请" {
                navigateTo system-sequence-cashloan-credit-biz-credit-apply
            }
            -> portal "授信申请"
            -> creditplatform "授信申请"
            -> xiaodai-gateway "授信申请"
            -> xiaodai "授信申请"
        user
            -> genechain "授信提交"
            -> portal "授信提交"
            -> creditplatform "授信提交"
            -> xiaodai-gateway "授信提交"
            -> xiaodai "授信确认"
        user
            -> genechain "授信确认"
            -> portal "授信确认"
            -> creditplatform "授信确认"
            -> xiaodai-gateway "授信确认"
            -> xiaodai "授信确认"
    }

    dynamic view system-sequence-cashloan-credit-biz-credit-apply {
        title "生活费授信"
        variant sequence

        user -> genechain "授信申请" { line solid }
        genechain -> portal "授信申请" { line solid }
        portal -> creditplatform "授信申请" { line solid }
        creditplatform -> xiaodai "授信申请" {
            line solid
            navigateTo container-sequence-xiaodai-credit-biz-credit-apply
        }
        xiaodai -> creditplatform "返回"
        creditplatform -> portal "返回"
        portal -> genechain "返回"
        genechain -> user "返回"
    }

    dynamic view container-sequence-xiaodai-credit-biz-credit-apply {
        title "生活费授信"
        variant sequence

        upstream -> xiaodai.backend "请求授信申请"
        xiaodai.backend -> xiaodai.db "查询数据库"
        alt {
            when "如果用户已有授信申请" {
                xiaodai.backend -> upstream "用户已有授信申请"
            }
            if "用户没有授信神器" {
                xiaodai.backend -> xiaodai.db "插入授信申请"
                xiaodai.backend -> upstream
            }
        }
        include upstream, xiaodai, downstream
    }

}